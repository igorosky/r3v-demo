<?xml version="1.0"?>
<!--
  scout: a differential drive base with a pan/tilt head carrying a 3D lidar.

  The same file is read by Gazebo and by r3v-renderer. The renderer draws only mesh visuals, so
  every visual is a unit mesh from ../meshes scaled to size (see tools/make_meshes.py), and the
  collisions are the matching primitives. The <gazebo> blocks are ignored outside Gazebo.

  Frames: base_link sits at the wheel axle (0.08 m above the ground), x forward, z up.
  Moving joints: left/right_wheel_joint (continuous), turret_joint (continuous, pan) and
  head_joint (revolute, tilt).
-->
<robot name="scout">
  <link name="base_link">
    <visual>
      <origin xyz="0 0 0.03"/>
      <geometry><mesh filename="package://r3v_sim/meshes/box.stl" scale="0.50 0.36 0.14"/></geometry>
      <material name="body"><color rgba="0.25 0.27 0.30 1"/></material>
    </visual>
    <collision>
      <origin xyz="0 0 0.03"/>
      <geometry><box size="0.50 0.36 0.14"/></geometry>
    </collision>
    <inertial>
      <origin xyz="0 0 0.03"/>
      <mass value="8.0"/>
      <inertia ixx="0.0995" ixy="0" ixz="0" iyy="0.1797" iyz="0" izz="0.2531"/>
    </inertial>
  </link>

  <link name="left_wheel_link">
    <visual>
      <origin rpy="1.5708 0 0"/>
      <geometry><mesh filename="package://r3v_sim/meshes/cylinder.stl" scale="0.08 0.08 0.04"/></geometry>
      <material name="tire"><color rgba="0.08 0.08 0.08 1"/></material>
    </visual>
    <collision>
      <origin rpy="1.5708 0 0"/>
      <geometry><cylinder radius="0.08" length="0.04"/></geometry>
    </collision>
    <inertial>
      <origin rpy="1.5708 0 0"/>
      <mass value="0.5"/>
      <inertia ixx="0.000867" ixy="0" ixz="0" iyy="0.000867" iyz="0" izz="0.0016"/>
    </inertial>
  </link>
  <joint name="left_wheel_joint" type="continuous">
    <parent link="base_link"/>
    <child link="left_wheel_link"/>
    <origin xyz="0 0.21 0"/>
    <axis xyz="0 1 0"/>
  </joint>

  <link name="right_wheel_link">
    <visual>
      <origin rpy="1.5708 0 0"/>
      <geometry><mesh filename="package://r3v_sim/meshes/cylinder.stl" scale="0.08 0.08 0.04"/></geometry>
      <material name="tire"><color rgba="0.08 0.08 0.08 1"/></material>
    </visual>
    <collision>
      <origin rpy="1.5708 0 0"/>
      <geometry><cylinder radius="0.08" length="0.04"/></geometry>
    </collision>
    <inertial>
      <origin rpy="1.5708 0 0"/>
      <mass value="0.5"/>
      <inertia ixx="0.000867" ixy="0" ixz="0" iyy="0.000867" iyz="0" izz="0.0016"/>
    </inertial>
  </link>
  <joint name="right_wheel_joint" type="continuous">
    <parent link="base_link"/>
    <child link="right_wheel_link"/>
    <origin xyz="0 -0.21 0"/>
    <axis xyz="0 1 0"/>
  </joint>

  <!-- Frictionless casters, front and back, touching the ground at the wheels' height. -->
  <link name="front_caster_link">
    <visual>
      <geometry><mesh filename="package://r3v_sim/meshes/sphere.stl" scale="0.03 0.03 0.03"/></geometry>
      <material name="tire"><color rgba="0.08 0.08 0.08 1"/></material>
    </visual>
    <collision>
      <geometry><sphere radius="0.03"/></geometry>
    </collision>
    <inertial>
      <mass value="0.1"/>
      <inertia ixx="0.000036" ixy="0" ixz="0" iyy="0.000036" iyz="0" izz="0.000036"/>
    </inertial>
  </link>
  <joint name="front_caster_joint" type="fixed">
    <parent link="base_link"/>
    <child link="front_caster_link"/>
    <origin xyz="0.19 0 -0.05"/>
  </joint>

  <link name="back_caster_link">
    <visual>
      <geometry><mesh filename="package://r3v_sim/meshes/sphere.stl" scale="0.03 0.03 0.03"/></geometry>
      <material name="tire"><color rgba="0.08 0.08 0.08 1"/></material>
    </visual>
    <collision>
      <geometry><sphere radius="0.03"/></geometry>
    </collision>
    <inertial>
      <mass value="0.1"/>
      <inertia ixx="0.000036" ixy="0" ixz="0" iyy="0.000036" iyz="0" izz="0.000036"/>
    </inertial>
  </link>
  <joint name="back_caster_joint" type="fixed">
    <parent link="base_link"/>
    <child link="back_caster_link"/>
    <origin xyz="-0.19 0 -0.05"/>
  </joint>

  <!-- Turret: a disc with a fork of two plates holding the head. -->
  <link name="turret_link">
    <visual>
      <origin xyz="0 0 0.015"/>
      <geometry><mesh filename="package://r3v_sim/meshes/cylinder.stl" scale="0.08 0.08 0.03"/></geometry>
      <material name="turret"><color rgba="0.95 0.55 0.10 1"/></material>
    </visual>
    <visual>
      <origin xyz="0 0.07 0.10"/>
      <geometry><mesh filename="package://r3v_sim/meshes/box.stl" scale="0.06 0.02 0.14"/></geometry>
      <material name="turret"><color rgba="0.95 0.55 0.10 1"/></material>
    </visual>
    <visual>
      <origin xyz="0 -0.07 0.10"/>
      <geometry><mesh filename="package://r3v_sim/meshes/box.stl" scale="0.06 0.02 0.14"/></geometry>
      <material name="turret"><color rgba="0.95 0.55 0.10 1"/></material>
    </visual>
    <collision>
      <origin xyz="0 0 0.015"/>
      <geometry><cylinder radius="0.08" length="0.03"/></geometry>
    </collision>
    <collision>
      <origin xyz="0 0.07 0.10"/>
      <geometry><box size="0.06 0.02 0.14"/></geometry>
    </collision>
    <collision>
      <origin xyz="0 -0.07 0.10"/>
      <geometry><box size="0.06 0.02 0.14"/></geometry>
    </collision>
    <inertial>
      <origin xyz="0 0 0.06"/>
      <mass value="0.6"/>
      <inertia ixx="0.00273" ixy="0" ixz="0" iyy="0.00273" iyz="0" izz="0.00256"/>
    </inertial>
  </link>
  <joint name="turret_joint" type="continuous">
    <parent link="base_link"/>
    <child link="turret_link"/>
    <origin xyz="0.10 0 0.10"/>
    <axis xyz="0 0 1"/>
  </joint>

  <link name="head_link">
    <visual>
      <geometry><mesh filename="package://r3v_sim/meshes/box.stl" scale="0.10 0.11 0.08"/></geometry>
      <material name="head"><color rgba="0.20 0.45 0.80 1"/></material>
    </visual>
    <collision>
      <geometry><box size="0.10 0.11 0.08"/></geometry>
    </collision>
    <inertial>
      <mass value="0.3"/>
      <inertia ixx="0.000463" ixy="0" ixz="0" iyy="0.000410" iyz="0" izz="0.000553"/>
    </inertial>
  </link>
  <joint name="head_joint" type="revolute">
    <parent link="turret_link"/>
    <child link="head_link"/>
    <origin xyz="0 0 0.12"/>
    <axis xyz="0 1 0"/>
    <limit lower="-0.5" upper="0.5" effort="5" velocity="1.5"/>
  </joint>

  <link name="lidar_link">
    <visual>
      <geometry><mesh filename="package://r3v_sim/meshes/cylinder.stl" scale="0.04 0.04 0.05"/></geometry>
      <material name="sensor"><color rgba="0.12 0.12 0.14 1"/></material>
    </visual>
    <collision>
      <geometry><cylinder radius="0.04" length="0.05"/></geometry>
    </collision>
    <inertial>
      <mass value="0.2"/>
      <inertia ixx="0.000122" ixy="0" ixz="0" iyy="0.000122" iyz="0" izz="0.00016"/>
    </inertial>
  </link>
  <joint name="lidar_joint" type="fixed">
    <parent link="head_link"/>
    <child link="lidar_link"/>
    <origin xyz="0 0 0.065"/>
  </joint>

  <gazebo reference="left_wheel_link"><mu1>1.0</mu1><mu2>1.0</mu2></gazebo>
  <gazebo reference="right_wheel_link"><mu1>1.0</mu1><mu2>1.0</mu2></gazebo>
  <gazebo reference="front_caster_link"><mu1>0.0</mu1><mu2>0.0</mu2></gazebo>
  <gazebo reference="back_caster_link"><mu1>0.0</mu1><mu2>0.0</mu2></gazebo>

  <!--
    16 x 360 rays over 30 x 180 degrees at 10 Hz. Only half of the horizon is covered, so turning
    the turret changes what the lidar sees. The fixed lidar_joint is merged into head_link by the
    URDF to SDF conversion, gz_frame_id keeps the cloud in lidar_link's frame.
  -->
  <gazebo reference="lidar_link">
    <sensor name="lidar" type="gpu_lidar">
      <topic>lidar</topic>
      <gz_frame_id>lidar_link</gz_frame_id>
      <update_rate>10</update_rate>
      <always_on>true</always_on>
      <visualize>true</visualize>
      <lidar>
        <scan>
          <horizontal>
            <samples>360</samples>
            <min_angle>-1.5708</min_angle>
            <max_angle>1.5708</max_angle>
          </horizontal>
          <vertical>
            <samples>16</samples>
            <min_angle>-0.2618</min_angle>
            <max_angle>0.2618</max_angle>
          </vertical>
        </scan>
        <range>
          <min>0.3</min>
          <max>20.0</max>
          <resolution>0.01</resolution>
        </range>
      </lidar>
    </sensor>
  </gazebo>

  <gazebo>
    <plugin filename="gz-sim-diff-drive-system" name="gz::sim::systems::DiffDrive">
      <left_joint>left_wheel_joint</left_joint>
      <right_joint>right_wheel_joint</right_joint>
      <wheel_separation>0.42</wheel_separation>
      <wheel_radius>0.08</wheel_radius>
      <topic>cmd_vel</topic>
      <max_linear_acceleration>1.0</max_linear_acceleration>
      <max_angular_acceleration>2.0</max_angular_acceleration>
    </plugin>
    <!-- Ground truth pose as odom -> base_link; odom is the world frame, so the TF never drifts. -->
    <plugin filename="gz-sim-odometry-publisher-system" name="gz::sim::systems::OdometryPublisher">
      <odom_frame>odom</odom_frame>
      <robot_base_frame>base_link</robot_base_frame>
      <odom_topic>odom</odom_topic>
      <tf_topic>odom/tf</tf_topic>
      <odom_publish_frequency>50</odom_publish_frequency>
      <dimensions>3</dimensions>
    </plugin>
    <plugin filename="gz-sim-joint-state-publisher-system" name="gz::sim::systems::JointStatePublisher">
      <topic>joint_states</topic>
      <update_rate>50</update_rate>
    </plugin>
    <!-- The turret spins at 0.5 rad/s from the start, turret/pan_vel changes the speed. -->
    <plugin filename="gz-sim-joint-controller-system" name="gz::sim::systems::JointController">
      <joint_name>turret_joint</joint_name>
      <topic>turret/pan_vel</topic>
      <initial_velocity>0.5</initial_velocity>
    </plugin>
    <plugin filename="gz-sim-joint-position-controller-system" name="gz::sim::systems::JointPositionController">
      <joint_name>head_joint</joint_name>
      <topic>turret/tilt_pos</topic>
      <p_gain>3.0</p_gain>
      <i_gain>0.5</i_gain>
      <d_gain>0.1</d_gain>
      <i_max>1.0</i_max>
      <i_min>-1.0</i_min>
      <cmd_max>5.0</cmd_max>
      <cmd_min>-5.0</cmd_min>
    </plugin>
  </gazebo>
</robot>
